{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas-clarus:schema:run-manifest:0.1.0",
  "title": "ATLAS Clarus Workflow v3.4.0 Run Manifest v0.1.0",
  "description": "Complete machine-readable execution evidence for an ATLAS Clarus Workflow v3.4.0 run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "workflow_version", "software", "input", "master",
    "operation", "bindings", "layer_status"
  ],
  "properties": {
    "schema_id": {"const": "ATLAS_CLARUS_RUN_MANIFEST_V0_1_0"},
    "workflow_version": {"const": "3.4.0"},
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "sha256"],
      "properties": {
        "authority": {"const": "DOCUMENTED_8_BIT_SRGB"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "row_count"],
      "properties": {
        "filename": {"const": "atlas_master__active_master__v2_illumext.pkl"},
        "sha256": {"const": "8283ab91b10f89ac758d09ecf5fb4d6343536600a06dd468b1cc1ecf4ec747c4"},
        "row_count": {"const": 13283}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_variant", "k", "seed", "delta_lambda_mode",
        "candidate_corridor", "candidate_count",
        "production_reference_selection", "deltaE_in_selection"
      ],
      "properties": {
        "reference_variant": {
          "enum": ["RGB_ONLY_DLambda_POSTHOC", "RGB_ONLY_DLambda_ACTIVE_PRODUCTION_SELECTION"]
        },
        "k": {"const": "UNLIMITED"},
        "seed": {"const": 42},
        "delta_lambda_mode": {"enum": ["POSTHOC", "ACTIVE"]},
        "candidate_corridor": {"enum": ["SOURCE_ONLY", "RGB_TOP_2"]},
        "candidate_count": {"enum": [1, 2]},
        "production_reference_selection": {"enum": ["SOURCE_IDENTITY", "MIN_ABS_DELTA_LAMBDA_THEN_LOWER_ATLAS_ROW_ID"]},
        "deltaE_in_selection": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"reference_variant": {"const": "RGB_ONLY_DLambda_POSTHOC"}}},
          "then": {"properties": {
            "delta_lambda_mode": {"const": "POSTHOC"},
            "candidate_corridor": {"const": "SOURCE_ONLY"},
            "candidate_count": {"const": 1},
            "production_reference_selection": {"const": "SOURCE_IDENTITY"}
          }}
        },
        {
          "if": {"properties": {"reference_variant": {"const": "RGB_ONLY_DLambda_ACTIVE_PRODUCTION_SELECTION"}}},
          "then": {"properties": {
            "delta_lambda_mode": {"const": "ACTIVE"},
            "candidate_corridor": {"const": "RGB_TOP_2"},
            "candidate_count": {"const": 2},
            "production_reference_selection": {"const": "MIN_ABS_DELTA_LAMBDA_THEN_LOWER_ATLAS_ROW_ID"}
          }}
        }
      ]
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "binding-record.schema.json"}
    },
    "layer_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "persistence", "cross_system", "device", "measured_qc"],
      "properties": {
        "runtime": {"$ref": "#/$defs/status"},
        "persistence": {"$ref": "#/$defs/status"},
        "cross_system": {"$ref": "#/$defs/status"},
        "device": {"$ref": "#/$defs/status"},
        "measured_qc": {"$ref": "#/$defs/status"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["PASS", "FAIL", "NOT_EVIDENCED", "NOT_PROVIDED", "NOT_MEASURED", "NOT_APPLICABLE"]}
  }
}
