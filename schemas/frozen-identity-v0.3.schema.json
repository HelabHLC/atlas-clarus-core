{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HelabHLC/atlas-clarus-core/main/schemas/frozen-identity-v0.3.schema.json",
  "title": "ATLAS Clarus Frozen Reference Identity v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "atlas_master_sha256",
    "atlas_row_id",
    "binding_rule_version",
    "master_version",
    "reference",
    "reference_rgb",
    "freeze_status",
    "identity_digest"
  ],
  "properties": {
    "atlas_master_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "atlas_row_id": {"type":"integer","minimum":0},
    "binding_rule_version": {"type":"string","minLength":1},
    "master_version": {"type":"string","minLength":1},
    "reference": {"type":"string","minLength":1},
    "reference_rgb": {
      "type":"array","minItems":3,"maxItems":3,"items":{"type":"integer","minimum":0,"maximum":255}
    },
    "freeze_status": {"const":"FROZEN"},
    "identity_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
