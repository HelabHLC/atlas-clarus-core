{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas-clarus:schema:recognised-input-record:0.1.0",
  "title": "ATLAS Clarus Recognised Input Record v0.1.0",
  "description": "Experimental/shadow inventory of supplied source representations before authority selection or ATLAS binding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "router_mode", "case_id", "representations"],
  "properties": {
    "schema_id": {"const": "ATLAS_CLARUS_RECOGNISED_INPUT_RECORD_V0_1_0"},
    "router_mode": {"const": "EXPERIMENTAL_SHADOW"},
    "case_id": {"type": "string", "minLength": 1},
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["representation_id", "input_type", "raw_value", "provenance_status"],
        "properties": {
          "representation_id": {"type": "string", "minLength": 1},
          "input_type": {
            "enum": ["EXACT_ATLAS", "EXACT_HLC", "SPECTRAL", "CIELAB", "SRGB", "HEX", "DEVICE_RGB", "CMYK", "NAMED_COLOUR", "ARTWORK", "UNKNOWN"]
          },
          "raw_value": {},
          "declared_conditions": {"type": "object"},
          "source_identifier": {"type": ["string", "null"]},
          "source_version": {"type": ["string", "null"]},
          "source_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "approval_reference": {"type": ["string", "null"]},
          "provenance_status": {"enum": ["DOCUMENTED", "PARTIAL", "UNRESOLVED"]}
        }
      }
    }
  }
}
